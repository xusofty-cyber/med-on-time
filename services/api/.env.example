# services/api 环境变量示例（复制为 .env 后填值；密钥只存服务端引用，禁止提交真实值）
PORT=3000

# PostgreSQL 15+（见 prisma/schema.prisma）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medontime?schema=public"

# Redis 7（BullMQ 提醒延迟队列；仅存可丢失数据）
REDIS_URL="redis://localhost:6379"

# JWT（access 短有效期 + refresh 旋转）
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="30d"

# AI 网关第三方密钥（零预算免费档；仅服务端引用，禁止进客户端包/日志）
SPARK_API_PASSWORD=""
ZHIPU_API_KEY=""
DEEPSEEK_API_KEY=""

# 腾讯云短信（代码就绪、暂缓上线：个人无法申请签名/模板，需企业认证；留空 = 短信通道诚实不可用，发码返回 40313）
#TENCENT_SMS_SECRET_ID=""
#TENCENT_SMS_SECRET_KEY=""
#TENCENT_SMS_SDK_APP_ID=""
#TENCENT_SMS_SIGN_NAME=""
#TENCENT_SMS_TEMPLATE_ID_REGISTER=""
#TENCENT_SMS_TEMPLATE_ID_LOGIN=""
#TENCENT_SMS_TEMPLATE_ID_RESET=""
#TENCENT_SMS_TEMPLATE_ID_REMINDER=""
