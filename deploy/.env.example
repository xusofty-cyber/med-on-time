# ============================================================
# MedOnTime 部署环境变量模板 —— 复制为 deploy/.env 后逐项填入真实值。
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# 真实 .env 严禁入仓（仓库 .gitignore 已排除 .env），严禁粘贴到聊天/工单。
# 密钥一律用 openssl rand -hex 32 现场生成，每项独立、不要复用。
# ============================================================

# ---------- 基础 ----------
# 运行环境标识：必须 production（生产下各守卫拒绝开发默认密钥兜底）
NODE_ENV=production
# API 容器内监听端口（不直接映射宿主机，经 web/admin 的 nginx 反代访问）
PORT=3000
# 构建期 npm 源（国内服务器建议 npmmirror；海外可改官方源）
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 数据库（既有容器 nexasx-postgres 内新建） ----------
# medontime 角色密码：db-init.sh 用它建角色；同时拼进 DATABASE_URL。
# 生成：openssl rand -hex 24（避免特殊字符方便拼 URL）
DB_PASSWORD=请替换为随机密码
# 应用连接串（容器网络内以主机名 nexasx-postgres 访问既有 PG 16）：
# 密码部分必须与上面的 DB_PASSWORD 完全一致。
DATABASE_URL=postgresql://medontime:请替换为与DB_PASSWORD相同的值@nexasx-postgres:5432/medontime

# ---------- Redis（本项目自建容器） ----------
# compose 服务名 redis；无密码（仅 compose 内网可达，不映射宿主机端口）
REDIS_URL=redis://redis:6379

# ---------- JWT 密钥（三者各自独立生成） ----------
# 用户端 access token 签名密钥。生成：openssl rand -hex 32
JWT_ACCESS_SECRET=请替换
# 用户端 refresh token 签名密钥（与 access 不同值）。生成：openssl rand -hex 32
JWT_REFRESH_SECRET=请替换
# 后台管理员 token 签名密钥（未配置会回退 JWT_ACCESS_SECRET，生产建议独立配）
# 生成：openssl rand -hex 32
ADMIN_JWT_SECRET=请替换
# token 有效期（一般不用改）
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# ---------- 字段加密密钥（生产必配，缺失会降级明文/开发默认值） ----------
# 手机号 AES-256-GCM 加密密钥：必须 32 字节，hex 64 字符。生成：openssl rand -hex 32
PHONE_ENCRYPTION_KEY=请替换为64位hex
# 手机号 HMAC-SHA256 查询哈希密钥：任意长字符串。生成：openssl rand -hex 32
PHONE_HMAC_KEY=请替换
# 病历正文/紧急联系人电话字段加密密钥：32 字节，hex 64 字符。生成：openssl rand -hex 32
# 注意：上线后不可更换/丢失，否则既有密文字段无法解密；请与备份一同妥善保管。
EHR_ENC_KEY=请替换为64位hex

# ---------- 功能开关 ----------
# AI 健康助手总开关：网关与医学审校未完成前保持 false（POC-2 暂停中）
AI_ENABLED=false

# ---------- 注册验证通道（V1.3：邮箱验证码 / 微信先行，见 docs/dev/AUTH_CHANNELS.md） ----------
# 邮箱验证码发送（SMTP）：SMTP_URL 优先（如 smtp://user:pass@smtp.example.com:587）；
# 或用下方分项。两者都不配 → 走 dev stub 只打掩码日志，邮箱验证码不真实发送（试点期可接受，正式开放注册前必配）。
#SMTP_URL=
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=MedOnTime 药准时 <no-reply@medontime.app>
# 微信小程序登录/手机号验证：公众平台「开发管理 → 开发设置」获取，须与小程序 appid 同一主体。
# 不配 → 微信登录、微信绑定、微信手机号验证统一返回业务码 40312（未开通），不影响其他通道。
#WECHAT_MINIAPP_APPID=
#WECHAT_MINIAPP_SECRET=

# ---------- 后台管理员播种（deploy.sh 调用 create-admin 时使用） ----------
# 首次部署后请立即用该账号登录后台并改密；之后轮换密码同步改这里再重跑播种。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为至少8位的强密码
ADMIN_DISPLAY_NAME=系统管理员

# ---------- 前端宿主机端口 ----------
# Web 用户门户 http://服务器IP:WEB_PORT
WEB_PORT=8080
# 后台管理平台 http://服务器IP:ADMIN_PORT
ADMIN_PORT=8081
